# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=raw_sensor_data
KAFKA_PROCESSED_TOPIC=processed_events
KAFKA_ANOMALY_TOPIC=anomalies

# Producer
PRODUCER_RATE=1000
SENSOR_COUNT=120

# Model
MODEL_PATH=models/isolation_forest.joblib
MODEL_B_PATH=models/lof.joblib
MODEL_VERSION=baseline
MODEL_A_WEIGHT=0.8
MODEL_B_WEIGHT=0.2

# API
API_HOST=0.0.0.0
API_PORT=8000

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Spark
SPARK_SHUFFLE_PARTITIONS=8
SPARK_CHECKPOINT_DIR=/checkpoints
DELTA_DATA_DIR=/data/delta
SPARK_WATERMARK_DELAY=10 minutes

# Training
TRAINING_DATA_PATH=data/sample_sensor_data.csv

# Logging
LOG_LEVEL=INFO
