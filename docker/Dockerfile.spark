FROM apache/spark:3.5.3-python3

WORKDIR /app

USER root

# Install Python dependencies for the streaming job
RUN pip install --default-timeout=1000 --no-cache-dir pyspark==3.5.3 delta-spark==3.2.0

# Download required JARs for Kafka and Delta Lake support
RUN mkdir -p /opt/spark/jars && \
    cd /opt/spark/jars && \
    curl -sLO https://repo1.maven.org/maven2/org/apache/spark/spark-sql-kafka-0-10_2.12/3.5.3/spark-sql-kafka-0-10_2.12-3.5.3.jar && \
    curl -sLO https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/3.5.1/kafka-clients-3.5.1.jar && \
    curl -sLO https://repo1.maven.org/maven2/org/apache/commons/commons-pool2/2.12.0/commons-pool2-2.12.0.jar && \
    curl -sLO https://repo1.maven.org/maven2/org/apache/spark/spark-token-provider-kafka-0-10_2.12/3.5.3/spark-token-provider-kafka-0-10_2.12-3.5.3.jar && \
    curl -sLO https://repo1.maven.org/maven2/io/delta/delta-spark_2.12/3.2.0/delta-spark_2.12-3.2.0.jar && \
    curl -sLO https://repo1.maven.org/maven2/io/delta/delta-storage/3.2.0/delta-storage-3.2.0.jar

COPY src ./src

CMD ["python", "-m", "src.spark.spark_streaming"]
